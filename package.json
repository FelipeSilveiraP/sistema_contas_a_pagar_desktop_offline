{
  "name": "findesk",
  "private": true,
  "version": "1.3.5",
  "description": "Sistema de Contas a Pagar — Chaveiro Universal",
  "author": "Chaveiro Universal",
  "main": "desktop/main.js",
  "scripts": {
    "build:css": "tailwindcss -i frontend/css/tailwind.input.css -o frontend/dist/tailwind.css --minify",
    "build:ts": "esbuild frontend/ts/main.ts --bundle --outdir=frontend/dist --entry-names=app --format=esm --splitting --target=es2022",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run build:css && npm run build:ts",
    "app": "electron desktop/main.js",
    "dev": "npm run build && electron desktop/main.js",
    "test:mascaras": "node desktop/teste-mascaras.js",
    "test:filtros": "node desktop/teste-filtros.js",
    "test:frontend": "node desktop/teste-mascaras.js && node desktop/teste-filtros.js && node desktop/teste-automacoes.js",
    "jre": "node instalador/gerar-jre.js",
    "instalador": "node instalador/empacotar.js",
    "publicar": "node instalador/publicar.js",
    "test:automacoes": "node desktop/teste-automacoes.js"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.9",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "pdf-lib": "1.17.1"
  }
}
