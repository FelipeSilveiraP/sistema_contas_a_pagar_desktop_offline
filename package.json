{
  "name": "findesk",
  "private": true,
  "version": "0.1.0",
  "description": "FinDesk - Contas a Pagar Chaveiro Universal",
  "scripts": {
    "build:css": "tailwindcss -i frontend/css/tailwind.input.css -o frontend/dist/tailwind.css --minify",
    "build:ts": "esbuild frontend/ts/main.ts --bundle --outfile=frontend/dist/app.js --format=iife --target=es2022",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run build:css && npm run build:ts",
    "app": "electron desktop/main.js",
    "dev": "npm run build && electron desktop/main.js"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.9",
    "electron": "^33.0.0",
    "esbuild": "^0.24.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
